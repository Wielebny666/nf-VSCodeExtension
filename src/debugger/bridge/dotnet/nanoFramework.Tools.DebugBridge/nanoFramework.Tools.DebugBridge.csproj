<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>nanoFramework.Tools.DebugBridge</RootNamespace>
    <AssemblyName>nanoFramework.Tools.DebugBridge</AssemblyName>
    <Description>Debug bridge process for VS Code nanoFramework debugging</Description>
    <Authors>.NET Foundation and Contributors</Authors>
    <Company>nanoframework</Company>
    <Copyright>Copyright (c) .NET Foundation and Contributors</Copyright>
    
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    
    <!-- Disable trimming - the nanoFramework debug library uses reflection extensively 
         for Wire Protocol communication and assembly inspection -->
    <PublishTrimmed>false</PublishTrimmed>

    <!-- Build against a local nf-debugger checkout (with unreleased fixes) when one is present;
         otherwise fall back to the NuGet package. -->
    <NfDebuggerProject Condition="'$(NfDebuggerProject)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\..\..\nf-debugger-local-fixes\nanoFramework.Tools.DebugLibrary.Net\nanoFramework.Tools.DebugLibrary.Net.csproj</NfDebuggerProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to nf-debugger library -->
    <PackageReference Include="nanoFramework.Tools.Debugger.Net" Version="*" Condition="!Exists('$(NfDebuggerProject)')" />
    <PackageReference Include="System.IO.Ports" Version="9.*" />
    <PackageReference Include="System.Text.Json" Version="9.*" />
    <!-- For parsing portable PDB files to extract source line information -->
    <PackageReference Include="System.Reflection.Metadata" Version="9.*" />
    <!-- For reading Windows PDB files using Mono.Cecil -->
    <PackageReference Include="Mono.Cecil" Version="0.11.*" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(NfDebuggerProject)')">
    <ProjectReference Include="$(NfDebuggerProject)" SetTargetFramework="TargetFramework=net8.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="nanoFramework.Tools.DebugBridge.Tests" />
  </ItemGroup>

</Project>
